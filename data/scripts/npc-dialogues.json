    {
      "id": "cs-npc-first",
      "type": "dialogue",
      "skippable": true,
      "lines": [
        {
          "speaker": "사이버보안",
          "portraitAssetId": null,
          "text": "분명 다 확인했는데… 또 놓친 게 있대."
        },
        {
          "speaker": "사이버보안",
          "portraitAssetId": null,
          "text": "내 실수 하나로 팀 과제가 잘못될까 봐 무서워."
        },
        {
          "speaker": "사이버보안",
          "portraitAssetId": null,
          "text": "나도 확신이 없는데… 나중에 누구를 지킬 수 있겠어."
        }
      ],
      "nextAction": {
        "type": "openMiniGame",
        "target": "cyber-click-to-purify"
      }
    },
    {
      "id": "cs-npc-revisit",
      "type": "dialogue",
      "skippable": true,
      "lines": [
        {
          "speaker": "사이버보안",
          "portraitAssetId": null,
          "text": "CLICK to PURIFY를 다시 확인해 볼까요?"
        }
      ],
      "nextAction": {
